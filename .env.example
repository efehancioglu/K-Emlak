# K-Emlak ortam degiskenleri ornegi.
# Bu dosyayi ".env" olarak kopyalayin ve degerleri kendi ortaminiza gore doldurun.
# (.env dosyasi git'e dahil edilmez.)

# --- Veritabani ---
# Docker ile yerel PostgreSQL (docker-compose.yml) icin varsayilan:
DATABASE_URL=postgresql+psycopg2://kemlak:kemlak_sifre@localhost:5432/kemlak_db
# Bulut (or. Neon) kullaniyorsaniz kendi baglanti dizenizle degistirin.

# --- Scraper (yalnizca veri toplama icin gerekli) ---
# venv icindeki python.exe'nin tam yolu
SCRAPER_PYTHON_PATH=C:\path\to\k_emlak\venv\Scripts\python.exe
# Scraper betiginin tam yolu
SCRAPER_SCRIPT_PATH=C:\path\to\k_emlak\k_emlak\hepsiemlak_istanbul_camoufox.py
# Scraper'in calisma dizini
SCRAPER_WORKING_DIR=C:\path\to\k_emlak\k_emlak
